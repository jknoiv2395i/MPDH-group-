# ==============================================================================
# MPDH GROUP - BACKEND CLOUD CONFIGURATION
# ==============================================================================

# Server Port
PORT=3001

# JWT Secret Key for Admin Authentication
JWT_SECRET=mphd_secure_jwt_secret_key_2026

# Admin Credentials
ADMIN_PASSWORD=admin123
ADMIN_BYPASS_KEY=mphd_master_bypass_2026

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Connection (Cloud Database)
# ------------------------------------------------------------------------------
# Replace with your MongoDB Atlas Connection String:
# e.g., mongodb+srv://username:password@cluster0.abcde.mongodb.net/mphd_db?retryWrites=true&w=majority
MONGODB_URI=

# ------------------------------------------------------------------------------
# 2. Supabase Storage (Cloud Media & Assets)
# ------------------------------------------------------------------------------
# Project Settings -> API -> Project URL
SUPABASE_URL=

# Project Settings -> API -> anon public key (or service_role key)
SUPABASE_ANON_KEY=

# Storage Bucket Name (Default: kimi-properties)
SUPABASE_BUCKET=kimi-properties
